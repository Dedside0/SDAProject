@using SDA.Db.Models

@model Ticket

<main class="editor-panel" id="editor-panel">
    @if (Model is null)
    {

        <div class="empty-editor" id="empty-editor" style="display: none;">
            <div class="empty-glyph">№</div>
            <h2>Выберите билет</h2>
            <p>Нажмите на любой билет слева, чтобы начать редактирование</p>
        </div>
    }
    else
    {
        <div id="ticket-editor" style="display: block;">
            <div class="editor-top">
                <div class="editor-top-left">
                    <div class="editor-label">Название билета</div>
                    <input class="ticket-title-input" type="text" value="@Model.Name" placeholder="Введите название…"
                           oninput="patchTicket('name', this.value)">
                </div>
                <div class="editor-actions">
                    <button class="btn-danger" onclick="confirmDeleteTicket(1)">🗑 Удалить</button>
                    <button class="btn-primary" onclick="saveCurrentTicket()">💾 Сохранить</button>
                </div>
            </div>

            <div class="meta-row">
                <div class="meta-field">
                    <label>Категория</label>
                    <input class="meta-input" type="text" value="@Model.Difficulty" oninput="patchTicket('category',this.value)">
                </div>
                <div class="meta-field">
                    <label>Сложность</label>
                    <select class="meta-select" onchange="patchTicket('difficulty',this.value)">
                        <option selected="">Лёгкий</option>
                        <option>Средний</option>
                        <option>Трудный</option>
                    </select>
                </div>
                <div class="meta-field">
                    <label>ID билета</label>
                    <input class="meta-input" type="text" value="1" disabled="" style="opacity:.4;cursor:default">
                </div>
                <div class="meta-field" style="grid-column:1/-1">
                    <label>Описание</label>
                    <textarea class="meta-input" rows="2"
                              oninput="patchTicket('description',this.value)">@Model.Description</textarea>
                </div>
            </div>

            <div class="section-head">
                <div class="section-title">Вопросы (@Model.TicketQuestions.Count())</div>
                <button class="add-q-btn" onclick="addQuestion(1)">＋ Добавить вопрос</button>
            </div>

            <div id="questions-container">

                @foreach (var ticketq in Model.TicketQuestions.OrderBy(tq => tq.Order))
                {
                    var q = ticketq.Question;
                    var orderIndex = Model.TicketQuestions.ToList().IndexOf(ticketq);
    
                    <div class="q-card" id="qcard-@q.Id">
                        <div class="q-card-head" onclick="toggleQuestion('@q.Id')">
                            <div class="q-index">@(orderIndex + 1).ToString("00")</div>
                            <div class="q-preview" id="qprev-@q.Id">@(string.IsNullOrEmpty(q.Text) ? "Без текста" : q.Text)</div>
                            <div class="q-expand-icon">▾</div>
                        </div>
        
                        <div class="q-card-body">
                            <div class="field-group">
                                <label>Текст вопроса</label>
                                <textarea class="field-input" rows="3"
                                          oninput="patchQuestion('@Model.Id', '@q.Id', 'text', this.value); document.getElementById('qprev-@q.Id').textContent = this.value || 'Без текста'">@Html.Raw(q.Text)</textarea>
                            </div>
            
                            <div class="field-group">
                                <label>Изображение (опционально)</label>
                                <div class="img-stub" onclick="uploadImage('@Model.Id', '@q.Id')">
                                    <div class="img-stub-icon">🖼</div>
                                    <span>@(string.IsNullOrEmpty(q.ImageUrl) ? "Нажмите, чтобы добавить изображение" : "Изменить изображение")</span>
                                </div>
                                @if (!string.IsNullOrEmpty(q.ImageUrl))
                                {
                                    <div class="image-preview" id="imagePreview-@q.Id">
                                        <img src="@q.ImageUrl" style="max-width: 200px; margin-top: 10px;" />
                                        <button type="button" class="remove-image-btn" onclick="removeImage('@Model.Id', '@q.Id')">✕ Удалить</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="image-preview" id="imagePreview-@q.Id" style="display: none;"></div>
                                }
                            </div>
            
                            <div class="field-group">
                                <div class="answers-label">Варианты ответов</div>
                                <div id="answers-@q.Id">
                                    @foreach (var answer in q.Answers)
                                    {
                                        var answerIndex = q.Answers.ToList().IndexOf(answer);
                                        var letter = ((char)(1040 + answerIndex)).ToString();

                                        <div class="answer-row" id="arow-@q.Id-@answerIndex">
                                            <div class="ans-letter-badge">@letter</div>
                                            <input class="ans-text-input" type="text" value="@answer.Text" placeholder="Вариант ответа…"
                                                   oninput="patchAnswer(@Model.Id,@q.Id,@answerIndex,'text',this.value)">
                                            <label class="correct-toggle" title="Правильный ответ">
                                                <input type="checkbox" onchange="patchAnswer(@Model.Id,@q.Id,@answerIndex,'correct',this.checked)">
                                                <div class="ct-box">✓</div>
                                                <span class="ct-label">Верный</span>
                                            </label>
                                            <button class="del-ans-btn" title="Удалить" onclick="deleteAnswer(@Model.Id,@q.Id,@answerIndex)">✕</button>
                                        </div>
                                    }
                                </div>
                                <button class="add-ans-btn" onclick="addAnswer('@Model.Id', '@q.Id')">＋ Добавить вариант</button>
                            </div>
            
                            <div class="field-group">
                                <button class="hint-toggle-btn" onclick="toggleHint('@q.Id')">
                                    @(string.IsNullOrEmpty(q.Exploration) ? "＋ Добавить подсказку" : "✎ Редактировать подсказку")
                                </button>
                                <div class="hint-field" id="hint-field-@q.Id" style="@(string.IsNullOrEmpty(q.Exploration) ? "display:none" : "")">
                                    <label style="font-size:.68rem;text-transform:uppercase;letter-spacing:.1em;color:var(--text-muted);display:block;margin-bottom:.35rem;margin-top:.5rem">Подсказка / объяснение</label>
                                    <textarea class="field-input" rows="2"
                                              oninput="patchQuestion('@Model.Id', '@q.Id', 'hint', this.value)">@Html.Raw(q.Exploration)</textarea>
                                </div>
                            </div>
                        </div>
        
                        <div class="q-card-foot">
                            <div class="q-move-btns">
                                <button class="move-btn" title="Вверх" onclick="moveQuestion('@Model.Id', '@q.Id', -1)">↑</button>
                                <button class="move-btn" title="Вниз" onclick="moveQuestion('@Model.Id', '@q.Id', 1)">↓</button>
                            </div>
                            <button class="del-q-btn" onclick="confirmDeleteQuestion('@Model.Id', '@q.Id')">✕ Удалить вопрос</button>
                        </div>
                    </div>
                }

            </div>
        </div>

    }
</main>