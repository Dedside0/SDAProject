@using System.Text.Json;
@using System.Text.Json.Serialization
@model List<SDA.Db.Models.Question>

<div class="content-exam" id="mainContent">

    <div id="testPage" class="test-container">
        @if (Model is null || Model.Count() == 0)
        {
             <div class="page-header">
        <div class="page-title-block">
            <h1 class="page-title">Работа<br>над ошибками</h1>
            <p class="page-subtitle">Только вопросы, в которых вы ошибались</p>
        </div>
    </div>

    <div id="mistakes-empty" class="empty-state">
        <div class="empty-icon">◎</div>
        <h3>Ошибок нет!</h3>
        <p>Пройдите экзамен или тренировку, чтобы здесь появились вопросы для повторения.</p>
    </div>
        }
        else
        {
            <div class="ticket-header">
                <div class="ticket-title" id="ticketNumberLabel">Работа над ошибками</div>
                <div class="test-meta">
                    <div class="quiz-timer" id="timerDisplay">20:00</div>
                </div>
            </div>

            <div class="question-progress">
                <div class="progress-bar">
                    <div class="progress-fill" id="progressFill"></div>
                </div>
                <div class="q-counter" id="questionCounter">1 / @Model.Count()</div>
            </div>

            @Html.AntiForgeryToken()

            <form id="finishForm" method="post" action="/Mistakes/FinishReview" style="display:none">
                @Html.AntiForgeryToken()
                <input type="hidden" name="TimeSpentSeconds" id="f_TimeSpent" />
                <input type="hidden" name="QuestionAttemptsJson" id="f_QAttemptsJson" />
            </form>

            <div id="quizMainArea">
                <div class="question-card" id="questionCard">
                    <div id="imageContainer"></div>
                    <div class="q-text" id="questionText"></div>
                    <ul class="answers-list" id="answersList"></ul>
                    <div class="explanation-box" id="explanationBox" style="display:none; margin-top: 1rem; padding: 1rem; background: var(--surface2); border-radius: 8px; border: 1px solid var(--accent);">
                        <strong>📖 Пояснение:</strong>
                        <p id="explanationText"></p>
                    </div>
                </div>
            </div>

            <div class="test-nav">
                <button class="btn-secondary" id="prevQuestionBtn">◀ Назад</button>
                <div class="question-dots" id="dotsContainer"></div>
                <button class="btn-primary" id="nextQuestionBtn">Вперёд ▶</button>
            </div>

            <div style="margin-top:1rem;display:flex;justify-content:flex-end">
                <button class="btn-primary" id="submitExamBtn"
                style="background:var(--danger);color:white">
                    Завершить работу над ошибками
                </button>
            </div>
        }
    </div>

</div>

@section Scripts {
<script>
// Сериализуем вопросы в JavaScript
const questions = @Html.Raw(JsonSerializer.Serialize(Model, new JsonSerializerOptions {
    PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
    ReferenceHandler = ReferenceHandler.IgnoreCycles
}));

const $$ = id => document.getElementById(id);

const els = {
    timer:      $$("timerDisplay"),
    progress:   $$("progressFill"),
    counter:    $$("questionCounter"),
    question:   $$("questionText"),
    answers:    $$("answersList"),
    image:      $$("imageContainer"),
    dots:       $$("dotsContainer"),
    ticket:     $$("ticketNumberLabel"),
    quiz:       $$("quizMainArea"),
    explanationBox: $$("explanationBox"),
    explanationText: $$("explanationText")
};

let index = 0;
let time = 20 * 60;
let finished = false;
let timer;

// Храним выбранные ответы
const answers = Array(questions.length).fill(null);

// Храним результат проверки для UI
const checkedAnswers = Array(questions.length).fill(null);

// Храним попытки для отправки на сервер
const questionAttempts = Array(questions.length).fill(null);

let questionStartTime = Date.now();
const examStartTime = Date.now();

// ──────────────────────────────────────────────────────────────────────────
els.ticket.textContent = "Работа над ошибками";

function allAnswered() {
    return answers.every(a => a !== null);
}

function render() {
    const qstn = questions[index];
    const selected = answers[index];
    const checked = checkedAnswers[index];

    els.question.textContent = `${index + 1}. ${qstn.text}`;

    // Изображение
    els.image.innerHTML = qstn.imageUrl
        ? `<img src="${qstn.imageUrl}" class="q-image" style="max-width:100%; max-height:200px; object-fit:contain;">`
        : `<div class="q-image-placeholder">📖 Нет изображения</div>`;

    // Варианты ответов
    els.answers.innerHTML = (qstn.answers || [])
    .sort((a, b) => a.order - b.order)
    .map((a, i) => {
        let cls = "";
        let letter = String.fromCharCode(1040 + i);
        
        if (checked !== null) {
            if (selected && selected.answerId === a.id) {
                cls = checked.correct ? "correct" : "wrong";
            }
            if (checked.correctId === a.id) {
                cls += " show-correct";
            }
        }
        
        return `
            <li class="answer-item ${cls}" data-answer-id="${a.id}">
                <span class="answer-letter">${letter}</span>
                <span class="answer-text">${escapeHtml(a.text)}</span>
            </li>`;
    }).join("");

    // Показываем пояснение, если вопрос уже отвечен
    if (checked !== null && qstn.explanation) {
        els.explanationBox.style.display = "block";
        els.explanationText.innerHTML = escapeHtml(qstn.explanation);
    } else {
        els.explanationBox.style.display = "none";
    }

    renderDots();
    updateProgress();
    updateNextButton();
    attachAnswerEvents();

    questionStartTime = Date.now();
}

function escapeHtml(text) {
    if (!text) return "";
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

function attachAnswerEvents() {
    document.querySelectorAll(".answer-item").forEach(item => {
        item.removeEventListener("click", handleAnswerClick);
        item.addEventListener("click", handleAnswerClick);
    });
}

function handleAnswerClick(e) {
    const li = e.currentTarget;

    if (finished) return;
    if (answers[index] !== null) return;

    const answerId = li.dataset.answerId;
    const qstn = questions[index];
    
    const selectedAnswer = qstn.answers.find(a => a.id === answerId);
    const correctAnswer = qstn.answers.find(a => a.isRight === true);
    console.log(selectedAnswer)
    console.log(correctAnswer)
    if (!selectedAnswer || !correctAnswer) {
        console.error('Ошибка: не найден ответ или правильный ответ');
        return;
    }
    
    const isRight = selectedAnswer.isRight === true;
    const correctAnswerId = correctAnswer.id;
    const answeredAt = new Date().toISOString();
    const timeSpentSeconds = Math.round((Date.now() - questionStartTime) / 1000);
    
    // Сохраняем ответ
    answers[index] = { 
        questionId: qstn.id, 
        answerId: answerId 
    };

    // Сохраняем попытку для отправки
    questionAttempts[index] = {
        questionId: qstn.id,
        selectedAnswerId: answerId,
        isCorrect: isRight,
        topic: qstn.topic ?? "",
        answeredAt: answeredAt,
        timeSpentSeconds: timeSpentSeconds
    };

    // Сохраняем для UI
    checkedAnswers[index] = {
        correct: isRight,
        correctId: correctAnswerId
    };

    render();

    if (allAnswered() && index === questions.length - 1) {
        finish();
    }
    // Если ответ правильный и есть следующий вопрос — автоматически переходим
    if (isRight && !finished && index < questions.length - 1) {
        setTimeout(() => {
            if (!finished) next();
        }, 300);
    }
}

function finish() {
    if (finished) return;
    finished = true;
    clearInterval(timer);

    const totalSeconds = Math.round((Date.now() - examStartTime) / 1000);

    // Формируем попытки для непросмотренных вопросов
    const attemptsPayload = questionAttempts.map((qa, i) => {
        if (qa !== null) return qa;
        return {
            questionId: questions[i].id,
            selectedAnswerId: null,
            isCorrect: false,
            topic: questions[i].topic ?? "",
            answeredAt: new Date().toISOString(),
            timeSpentSeconds: 0
        };
    });

    $$("f_TimeSpent").value = totalSeconds;
    $$("f_QAttemptsJson").value = JSON.stringify(attemptsPayload);
    $$("finishForm").submit();
}

const nextBtn = $$("nextQuestionBtn");

function updateNextButton() {
    if (nextBtn) {
        nextBtn.disabled = index === questions.length - 1 && !allAnswered();
    }
}

if (nextBtn) nextBtn.onclick = next;
const prevBtn = $$("prevQuestionBtn");
if (prevBtn) prevBtn.onclick = prev;

const submitBtn = $$("submitExamBtn");
if (submitBtn) {
    submitBtn.onclick = () => {
        if (!finished && confirm("Завершить работу над ошибками?")) finish();
    };
}

function renderDots() {
    if (!els.dots) return;
    els.dots.innerHTML = questions.map((_, i) => `
        <div class="q-dot ${i === index ? "current" : ""} ${answers[i] !== null ? "answered" : ""}"
             onclick="goTo(${i})">${i + 1}</div>
    `).join("");
}

function updateProgress() {
    if (!els.progress || !els.counter) return;
    const answered = answers.filter(x => x !== null).length;
    const percent = questions.length > 0 ? (answered / questions.length * 100) : 0;
    els.progress.style.width = `${percent}%`;
    els.counter.textContent = `${index + 1} / ${questions.length}`;
}

function goTo(i) { 
    if (!finished && (!checkedAnswers[index] || index !== i)) { 
        index = i; 
        render(); 
    } 
}

function next() {
    if (finished) return;
    if (index < questions.length - 1) { 
        index++; 
        render(); 
    } else if (allAnswered()) {
        if (confirm("Вы ответили на все вопросы. Завершить работу над ошибками?")) 
            finish();
    } else {
        alert("Ответьте на текущий вопрос, прежде чем завершить");
    }
}

function prev() {
    if (finished || index === 0) return;
    index--;
    render();
}

function updateTimer() {
    if (!els.timer) return;
    const m = String(Math.floor(time / 60)).padStart(2, "0");
    const s = String(time % 60).padStart(2, "0");
    els.timer.textContent = `${m}:${s}`;
    els.timer.classList.toggle("danger", time <= 60);
}

function startTimer() {
    updateTimer();
    timer = setInterval(() => {
        if (finished) return;
        if (time <= 0) { 
            finish(); 
            return; 
        }
        time--;
        updateTimer();
    }, 1000);
}

// Запускаем (только если есть вопросы)
if (questions && questions.length > 0) {
    render();
    startTimer();
}
</script>
}

