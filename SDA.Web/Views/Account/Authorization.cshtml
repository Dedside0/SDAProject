@model Authorization
@{
    Layout = "_LayoutAuth";
}

<div class="auth-tabs">
    <a class="auth-tab active" asp-controller="Account" asp-action="Authorization">Вход</a>
    <a class="auth-tab" asp-controller="Account" asp-action="Registration">Регистрация</a>
</div>
<form id="login-form" class="auth-form" method="post" asp-controller="Account" asp-action="Authorization">
        
    <div asp-validation-summary="ModelOnly"></div>
    <div class="form-group">
        <label class="form-label" asp-for="Login"></label>
        <input asp-for="Login" class="form-input">
        <span asp-validation-for="Login"></span>
    </div>
    <div class="form-group">
        <label class="form-label" asp-for="Password"></label>
        <div class="form-input-wrap">
            <input asp-for="Password" class="form-input">
            <button type="button" class="toggle-password" aria-label="Показать пароль">👁️</button>
        </div>
        <span asp-validation-for="Password"></span>
    </div>
    <div class="form-row">
        <label class="checkbox-wrap">
            <input type="checkbox" asp-for="IsRememberMe">
            <span class="custom-checkbox"></span>
            Запомнить меня
        </label>
        @* <a href="#" class="forgot-link">Забыли пароль?</a> *@
    </div>
    <button type="submit" class="btn-primary btn-block">Войти</button>
</form>
