<!-- ===== MISTAKES PAGE ===== -->
<section class="page" id="page-mistakes">
    <div class="page-header">
        <div class="page-title-block">
            <h1 class="page-title">Работа<br>над ошибками</h1>
            <p class="page-subtitle">Только вопросы, в которых вы ошибались</p>
        </div>
    </div>

    <div id="mistakes-empty" class="empty-state hidden">
        <div class="empty-icon">◎</div>
        <h3>Ошибок нет!</h3>
        <p>Пройдите экзамен или тренировку, чтобы здесь появились вопросы для повторения.</p>
    </div>

    <div id="mistakes-setup" class="setup-panel hidden">
        <p id="mistakes-setup-desc"></p>
        <button class="btn-primary" id="start-mistakes-btn">Начать работу над ошибками</button>
        <button class="btn-danger" id="clear-mistakes-btn">Очистить список ошибок</button>
    </div>

    <div id="mistakes-active" class="quiz-container hidden">
        <div class="quiz-topbar">
            <div class="quiz-progress-info">
                Вопрос <span id="mis-q-num">1</span> из <span id="mis-q-total">0</span>
            </div>
        </div>
        <div class="progress-bar">
            <div class="progress-fill" id="mis-progress-fill"></div>
        </div>
        <div class="question-card">
            <div class="q-image-placeholder" id="mis-img"></div>
            <p class="q-text" id="mis-q-text"></p>
            <ul class="answers-list" id="mis-answers"></ul>
            <div class="hint-box hidden" id="mis-hint"></div>
        </div>
        <div class="train-nav">
            <button class="btn-secondary" id="mis-prev-btn">← Назад</button>
            <button class="btn-primary" id="mis-next-btn">Далее →</button>
        </div>
    </div>

    <div id="mistakes-result" class="result-panel hidden">
        <div class="result-icon">◎</div>
        <h2>Сессия завершена</h2>
        <p id="mis-result-desc"></p>
        <button class="btn-primary" id="mis-retry-btn">Повторить</button>
    </div>
</section>