@using System.Text.Json;
@using System.Text.Json.Serialization
@model TicketVm

<!-- Страница активного теста (по умолчанию) -->
<div class="content" id="mainContent">
    
    <div id="testPage" class="test-container">
        <div class="ticket-header">
            <div class="ticket-title" id="ticketNumberLabel">Билет @Model.Name</div>
            <div class="test-meta">
                <div class="quiz-timer" id="timerDisplay">20:00</div>
            </div>
        </div>
        <div class="question-progress">
            <div class="progress-bar"><div class="progress-fill" id="progressFill"></div></div>
            <div class="q-counter" id="questionCounter">1 / 20</div>
        </div>

        

        <div id="quizMainArea">
            <!-- динамическая карточка вопроса -->
            <div class="question-card" id="questionCard">
                <div id="imageContainer"></div>
                <div class="q-text" id="questionText"></div>
                <ul class="answers-list" id="answersList"></ul>
            </div>
        </div>




        <div class="test-nav">
            <button class="btn-secondary" id="prevQuestionBtn">◀ Назад</button>
            <div class="question-dots" id="dotsContainer"></div>
            <button class="btn-primary" id="nextQuestionBtn">Вперёд ▶</button>
        </div>
        <div style="margin-top: 1rem; display: flex; justify-content: flex-end;">
            <button class="btn-primary" id="submitExamBtn" style="background: var(--danger); color:white;">Завершить экзамен</button>
        </div>
    </div>
</div>






@section Scripts {
<script>
    const ticket = @Html.Raw(JsonSerializer.Serialize(Model, new JsonSerializerOptions {
  PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
  ReferenceHandler = ReferenceHandler.IgnoreCycles
}));

const $$ = id => document.getElementById(id);

const els = {
  timer: $$("timerDisplay"),
  progress: $$("progressFill"),
  counter: $$("questionCounter"),
  question: $$("questionText"),
  answers: $$("answersList"),
  image: $$("imageContainer"),
  dots: $$("dotsContainer"),
  ticket: $$("ticketNumberLabel"),
  quiz: $$("quizMainArea")
};

const questions = [...(ticket.ticketQuestions || [])]
  .sort((a, b) => a.order - b.order)
  .map(x => x.question);

let index = 0;
let time = 20 * 60;
let finished = false;
let timer;
const answers = Array(questions.length).fill(null);
const checkedAnswers = Array(questions.length).fill(null);

els.ticket.textContent = ticket.name || "Билет";

function allAnswered() {
  return answers.every(a => a !== null);
}

function render() {
  const qstn = questions[index];
  const selected = answers[index];
  const checked = checkedAnswers[index];

  els.question.textContent = `${index + 1}. ${qstn.text}`;

  els.image.innerHTML = qstn.imageUrl
    ? `<img src="${qstn.imageUrl}" class="q-image">`
    : `<div class="q-image-placeholder">🚗 Нет изображения</div>`;

  els.answers.innerHTML = qstn.answers.map((a, i) => {
    let cls = "";

    if (checked !== null) {

      if (selected.answerId == a.id) {
        cls = checked.correct ? "correct" : "wrong";
      }

      if (checked.correctId == a.id) {
        cls += " show-correct";
      }
    }
    return `
        <li class="answer-item ${cls}" data-answer-id="${a.id}">

            <span class="answer-letter">
                ${String.fromCharCode(1040 + i)}
            </span>

            <span class="answer-text">
                ${a.text}
            </span>
        </li>
    `;
  }).join("");

  renderDots();
  updateProgress();
  updateNextButton();
  attachAnswerEvents();
}

function attachAnswerEvents() {
  const answerItems = document.querySelectorAll(".answer-item");

  answerItems.forEach((item) => {
    item.removeEventListener("click", handleAnswerClick);
    item.addEventListener("click", handleAnswerClick);
  });
}

async function handleAnswerClick(e) {
  const li = e.currentTarget;

  if (finished) return;
  if (answers[index] !== null) return;

  const answerId = li.dataset.answerId;
  const questionId = questions[index].id;

  try {

    const response = await fetch('/Exam/CheckQuestion', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        QuestionId: questionId,
        AnswerId: answerId
      })
    });

    if (!response.ok) {
      alert("Ошибка проверки");
      return;
    }

    const data = await response.json();

    // то что уйдет в CheckExam
    answers[index] = {
      questionId,
      answerId
    };

    // только для UI
    checkedAnswers[index] = {
      correct: data.correct,
      correctId: data.correctId
    };

    render();

  } catch (err) {
    console.error(err);
  }
}





async function finish() {
  finished = true;
  clearInterval(timer);

  const response = await fetch('/Exam/CheckExam', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      TicketId: @Model.Id,
      CheckAnswers: answers
    })
  })
  let data = await response.json();

  els.quiz.innerHTML = `
        <div class="result-panel">
            <div class="result-icon">${data.passed ? "🏆" : "❌"}</div>

            <h2>
                ${data.passed ? "Экзамен сдан!" : "Экзамен не сдан"}
            </h2>

            <p>
                ${data.correct} из ${questions.length} (${data.percent}%)
            </p>

            <div class="action-group">
                <button class="btn-primary"
                        onclick="location.reload()">
                    🔄 Заново
                </button>
            </div>
        </div>
    `;
}

const nextBtn = $$("nextQuestionBtn");

function updateNextButton() {

  const isLastQuestion =
    index === questions.length - 1;

  nextBtn.disabled =
    isLastQuestion && !allAnswered();
}

nextBtn.onclick = next;
$$("prevQuestionBtn").onclick = prev;

$$("submitExamBtn").onclick = () => {
  if (!finished && confirm("Завершить экзамен?")) {
    finish();
  }
};


function renderDots() {
  els.dots.innerHTML = questions.map((_, i) => `
        <div class="q-dot
            ${i === index ? "current" : ""}
            ${answers[i] !== null ? "answered" : ""}"
            onclick="goTo(${i})">
            ${i + 1}
        </div>
    `).join("");
}

function updateProgress() {
  const answered = answers.filter(x => x !== null).length;

  els.progress.style.width =
    `${answered / questions.length * 100}%`;

  els.counter.textContent =
    `${index + 1} / ${questions.length}`;
}

function goTo(i) {
  if (finished) return;
  index = i;
  render();
}

function next() {
  if (finished) return;

  if (index < questions.length - 1) {
    index++;
    render();
  } else if (confirm("Завершить экзамен?")) {
    finish();
  }
}

function prev() {
  if (finished || index === 0) return;

  index--;
  render();
}

function updateTimer() {
  const m = String(Math.floor(time / 60)).padStart(2, "0");
  const s = String(time % 60).padStart(2, "0");

  els.timer.textContent = `${m}:${s}`;
  els.timer.classList.toggle("danger", time <= 60);
}

function startTimer() {
  updateTimer();

  timer = setInterval(() => {
    if (finished) return;

    if (time <= 0) {
      alert("Время вышло");
      finish();
      return;
    }

    time--;
    updateTimer();
  }, 1000);
}

render();
startTimer();
</script>
}