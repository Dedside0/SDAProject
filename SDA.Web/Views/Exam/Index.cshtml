@using System.Text.Json;
@using System.Text.Json.Serialization
@model TicketVm

<div class="content-exam" id="mainContent">
    <div id="testPage" class="test-container">

        <div class="ticket-header">
            <div class="ticket-title" id="ticketNumberLabel">Билет @Model.Name</div>
            <div class="test-meta">
                <div class="quiz-timer" id="timerDisplay">20:00</div>
            </div>
        </div>

        <div class="question-progress">
            <div class="progress-bar">
                <div class="progress-fill" id="progressFill"></div>
            </div>
            <div class="q-counter" id="questionCounter">1 / 20</div>
        </div>

        @Html.AntiForgeryToken()

        <form id="finishForm" method="post" action="/Exam/FinishExam" style="display:none">
            @Html.AntiForgeryToken()
            <input type="hidden" name="TicketId"          id="f_TicketId" />
            <input type="hidden" name="TimeSpentSeconds"  id="f_TimeSpent" />
            <!-- JSON-строки, контроллер десериализует из строки -->
            <input type="hidden" name="QuestionAttemptsJson" id="f_QAttemptsJson" />
        </form>

        <div id="quizMainArea">
            <div class="question-card" id="questionCard">
                <div id="imageContainer"></div>
                <div class="q-text" id="questionText"></div>
                <ul class="answers-list" id="answersList"></ul>
            </div>
        </div>

        <div class="test-nav">
            <button class="btn-secondary" id="prevQuestionBtn">◀ Назад</button>
            <div class="question-dots" id="dotsContainer"></div>
            <button class="btn-primary" id="nextQuestionBtn">Вперёд ▶</button>
        </div>

        <div style="margin-top:1rem;display:flex;justify-content:flex-end">
            <button class="btn-primary" id="submitExamBtn"
                    style="background:var(--danger);color:white">
                Завершить экзамен
            </button>
        </div>

    </div>
</div>

@section Scripts {
<script>
const ticket = @Html.Raw(JsonSerializer.Serialize(Model, new JsonSerializerOptions {
    PropertyNamingPolicy      = JsonNamingPolicy.CamelCase,
    ReferenceHandler          = ReferenceHandler.IgnoreCycles
}));

const $$ = id => document.getElementById(id);

const els = {
    timer:    $$("timerDisplay"),
    progress: $$("progressFill"),
    counter:  $$("questionCounter"),
    question: $$("questionText"),
    answers:  $$("answersList"),
    image:    $$("imageContainer"),
    dots:     $$("dotsContainer"),
    ticket:   $$("ticketNumberLabel"),
    quiz:     $$("quizMainArea")
};

const questions = [...(ticket.ticketQuestions || [])]
    .sort((a, b) => a.order - b.order)
    .map(x => x.question);

let index    = 0;
let time     = 20 * 60;   // секунды
let finished = false;
let timer;

const answers = Array(questions.length).fill(null);

const checkedAnswers = Array(questions.length).fill(null);

const questionAttempts = Array(questions.length).fill(null);

let questionStartTime = Date.now();

const examStartTime = Date.now();

// ──────────────────────────────────────────────────────────────────────────
els.ticket.textContent = ticket.name || "Билет";

function allAnswered() {
    return answers.every(a => a !== null);
}

function render() {
    const qstn     = questions[index];
    const selected = answers[index];
    const checked  = checkedAnswers[index];

    els.question.textContent = `${index + 1}. ${qstn.text}`;

    els.image.innerHTML = qstn.imageUrl
        ? `<img src="${qstn.imageUrl}" class="q-image">`
        : `<div class="q-image-placeholder">🚗 Нет изображения</div>`;

    els.answers.innerHTML = qstn.answers.map((a, i) => {
        let cls = "";
        if (checked !== null) {
            if (selected.answerId == a.id)   cls = checked.correct ? "correct" : "wrong";
            if (checked.correctId == a.id)   cls += " show-correct";
        }
        return `
            <li class="answer-item ${cls}" data-answer-id="${a.id}">
                <span class="answer-letter">${String.fromCharCode(1040 + i)}</span>
                <span class="answer-text">${a.text}</span>
            </li>`;
    }).join("");

    renderDots();
    updateProgress();
    updateNextButton();
    attachAnswerEvents();

    // Фиксируем момент показа вопроса — нужен для TimeSpentSeconds
    questionStartTime = Date.now();
}

function attachAnswerEvents() {
    document.querySelectorAll(".answer-item").forEach(item => {
        item.removeEventListener("click", handleAnswerClick);
        item.addEventListener("click", handleAnswerClick);
    });
}

async function handleAnswerClick(e) {
    const li = e.currentTarget;
    if (finished)           return;
    if (answers[index] !== null) return;   // уже отвечен

    const answerId  = li.dataset.answerId;
    const questionId = questions[index].id;

    const answeredAt       = new Date().toISOString();
    const timeSpentSeconds = Math.round((Date.now() - questionStartTime) / 1000);

    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        const response = await fetch('/Exam/CheckQuestion', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({ QuestionId: questionId, AnswerId: answerId })
        });

        if (!response.ok) { alert("Ошибка проверки"); return; }

        const data = await response.json();
        // data = { correct: bool, correctId: guid }

        // ── Сохраняем ответ для отправки контроллеру ────────────────────
        answers[index] = { questionId, answerId };

        // ── Собираем QuestionAttempt для этого вопроса ───────────────────
        const qstn = questions[index];
        questionAttempts[index] = {
            questionId:       questionId,
            selectedAnswerId: answerId,
            isCorrect:        data.correct,
            // topic = имя темы из QuestionTheme (может быть null)
             topic:            qstn.topic ?? "",  
            answeredAt:       answeredAt,
            timeSpentSeconds: timeSpentSeconds
        };

        // ── Только для UI ────────────────────────────────────────────────
        checkedAnswers[index] = {
            correct:   data.correct,
            correctId: data.correctId
        };

        render();

    } catch (err) {
        console.error(err);
    }
}


function finish() {
    if (finished) return;
    finished = true;
    clearInterval(timer);

    const totalSeconds = Math.round((Date.now() - examStartTime) / 1000);

    const attemptsPayload = questionAttempts.map((qa, i) => {
        if (qa !== null) return qa;
        return {
            questionId:       questions[i].id,
            selectedAnswerId: null,
            isCorrect:        false,
            topic:            questions[i].topic ?? "",
            answeredAt:       new Date().toISOString(),
            timeSpentSeconds: 0
        };
    });

    $$("f_TicketId").value      = "@Model.Id";
    $$("f_TimeSpent").value     = totalSeconds;
    $$("f_QAttemptsJson").value = JSON.stringify(attemptsPayload);

    $$("finishForm").submit();
}


const nextBtn = $$("nextQuestionBtn");

function updateNextButton() {
    nextBtn.disabled = index === questions.length - 1 && !allAnswered();
}

nextBtn.onclick = next;
$$("prevQuestionBtn").onclick = prev;

$$("submitExamBtn").onclick = () => {
    if (!finished && confirm("Завершить экзамен?")) finish();
};

function renderDots() {
    els.dots.innerHTML = questions.map((_, i) => `
        <div class="q-dot ${i === index ? "current" : ""} ${answers[i] !== null ? "answered" : ""}"
             onclick="goTo(${i})">${i + 1}</div>`
    ).join("");
}

function updateProgress() {
    const answered = answers.filter(x => x !== null).length;
    els.progress.style.width = `${answered / questions.length * 100}%`;
    els.counter.textContent  = `${index + 1} / ${questions.length}`;
}

function goTo(i) { if (!finished) { index = i; render(); } }

function next() {
    if (finished) return;
    if (index < questions.length - 1) { index++; render(); }
    else if (confirm("Завершить экзамен?")) finish();
}

function prev() {
    if (finished || index === 0) return;
    index--;
    render();
}

function updateTimer() {
    const m = String(Math.floor(time / 60)).padStart(2, "0");
    const s = String(time % 60).padStart(2, "0");
    els.timer.textContent = `${m}:${s}`;
    els.timer.classList.toggle("danger", time <= 60);
}

function startTimer() {
    updateTimer();
    timer = setInterval(() => {
        if (finished) return;
        if (time <= 0) { finish(); return; }
        time--;
        updateTimer();
    }, 1000);
}

render();
startTimer();
</script>
}
