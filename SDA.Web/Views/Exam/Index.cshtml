@using SDA.Db.Models;
@using System.Text.Json;
@using System.Text.Json.Serialization
@model Ticket

<!-- Страница активного теста (по умолчанию) -->
<div class="content" id="mainContent">
    
    <div id="testPage" class="test-container">
        <div class="ticket-header">
            <div class="ticket-title" id="ticketNumberLabel">Билет 1</div>
            <div class="test-meta">
                <div class="quiz-timer" id="timerDisplay">20:00</div>
            </div>
        </div>
        <div class="question-progress">
            <div class="progress-bar"><div class="progress-fill" id="progressFill"></div></div>
            <div class="q-counter" id="questionCounter">1 / 20</div>
        </div>

        

        <div id="quizMainArea">
            <!-- динамическая карточка вопроса -->
            <div class="question-card" id="questionCard">
                <div id="imageContainer"></div>
                <div class="q-text" id="questionText"></div>
                <ul class="answers-list" id="answersList"></ul>
            </div>
        </div>






        <div class="test-nav">
            <button class="btn-secondary" id="prevQuestionBtn">◀ Назад</button>
            <div class="question-dots" id="dotsContainer"></div>
            <button class="btn-primary" id="nextQuestionBtn">Вперёд ▶</button>
        </div>
        <div style="margin-top: 1rem; display: flex; justify-content: flex-end;">
            <button class="btn-primary" id="submitExamBtn" style="background: var(--danger); color:white;">Завершить экзамен</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
const ticket = @Html.Raw(JsonSerializer.Serialize(Model, new JsonSerializerOptions {
    PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
    ReferenceHandler = ReferenceHandler.IgnoreCycles
}));

const $ = id => document.getElementById(id);

const els = {
    timer: $("timerDisplay"),
    progress: $("progressFill"),
    counter: $("questionCounter"),
    question: $("questionText"),
    answers: $("answersList"),
    image: $("imageContainer"),
    dots: $("dotsContainer"),
    ticket: $("ticketNumberLabel"),
    quiz: $("quizMainArea")
};

const questions = [...(ticket.ticketQuestions || [])]
    .sort((a,b) => a.order - b.order)
    .map(x => x.question);

let index = 0;
let time = 20 * 60;
let finished = false;
let timer;
const answers = Array(questions.length).fill(null);

els.ticket.textContent = ticket.name || "Билет";

function allAnswered() {
    return answers.every(a => a !== null);
}

function render() {
    const q = questions[index];
    const selected = answers[index];

    els.question.textContent = `${index + 1}. ${q.text}`;

    els.image.innerHTML = q.imageUrl
        ? `<img src="${q.imageUrl}" class="q-image">`
        : `<div class="q-image-placeholder">🚗 Нет изображения</div>`;

    els.answers.innerHTML = q.answers.map((a, i) => `
        <li class="answer-item ${selected === i ? "selected" : ""}"
            onclick="selectAnswer(${i})">
            <span class="answer-letter">${String.fromCharCode(1040 + i)}</span>
            <span class="answer-text">${a.text}</span>
        </li>
    `).join("");

    renderDots();
    updateProgress();
    updateNextButton();
}

function renderDots() {
    els.dots.innerHTML = questions.map((_, i) => `
        <div class="q-dot
            ${i === index ? "current" : ""}
            ${answers[i] !== null ? "answered" : ""}"
            onclick="goTo(${i})">
            ${i + 1}
        </div>
    `).join("");
}

function updateProgress() {
    const answered = answers.filter(x => x !== null).length;

    els.progress.style.width =
        `${answered / questions.length * 100}%`;

    els.counter.textContent =
        `${index + 1} / ${questions.length}`;
}

function selectAnswer(i) {
    if (finished) return;

    answers[index] = i;
    render();
}

function goTo(i) {
    if (finished) return;
    index = i;
    render();
}

function next() {
    if (finished) return;

    if (index < questions.length - 1) {
        index++;
        render();
    } else if (confirm("Завершить экзамен?")) {
        finish();
    }
}

function prev() {
    if (finished || index === 0) return;

    index--;
    render();
}

function updateTimer() {
    const m = String(Math.floor(time / 60)).padStart(2, "0");
    const s = String(time % 60).padStart(2, "0");

    els.timer.textContent = `${m}:${s}`;
    els.timer.classList.toggle("danger", time <= 60);
}

function startTimer() {
    updateTimer();

    timer = setInterval(() => {
        if (finished) return;

        if (time <= 0) {
            alert("Время вышло");
            finish();
            return;
        }

        time--;
        updateTimer();
    }, 1000);
}

function finish() {
    finished = true;
    clearInterval(timer);

    let correct = 0;

    questions.forEach((q, i) => {
        const right = q.answers.findIndex(a => a.isRight);
        if (answers[i] === right) correct++;
    });

    const percent = Math.round(correct / questions.length * 100);
    const passed = percent >= 80;

    localStorage.setItem(
        "pdd_exam_history",
        JSON.stringify([
            {
                date: new Date().toLocaleString(),
                ticket: ticket.name,
                correct,
                total: questions.length,
                percent,
                passed
            },
            ...JSON.parse(localStorage.getItem("pdd_exam_history") || "[]")
        ])
    );

    els.quiz.innerHTML = `
        <div class="result-panel">
            <div class="result-icon">${passed ? "🏆" : "❌"}</div>

            <h2>
                ${passed ? "Экзамен сдан!" : "Экзамен не сдан"}
            </h2>

            <p>
                ${correct} из ${questions.length} (${percent}%)
            </p>

            <div class="action-group">
                <button class="btn-primary"
                        onclick="location.reload()">
                    🔄 Заново
                </button>
            </div>
        </div>
    `;
}

const nextBtn = $("nextQuestionBtn");

function updateNextButton() {

    const isLastQuestion =
        index === questions.length - 1;

    nextBtn.disabled =
        isLastQuestion && !allAnswered();
}

nextBtn.onclick = next;
$("prevQuestionBtn").onclick = prev;

$("submitExamBtn").onclick = () => {
    if (!finished && confirm("Завершить экзамен?")) {
        finish();
    }
};

render();
startTimer();
</script>
}